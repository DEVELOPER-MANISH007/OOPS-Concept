from abc import ABC, abstractmethod


class MLModel(ABC):
    """
    Abstract base class for Machine Learning models.
    """

    def __init__(self, name):
        self.name = name

    @abstractmethod
    def train(self, dataset):
        """Train the model on a dataset."""
        pass

    @abstractmethod
    def predict(self, data):
        """Make predictions on new data."""
        pass

    def model_info(self):
        return f"Model: {self.name}"


class ClassificationModel(MLModel):
    """
    Classification model implementation.
    """

    def train(self, dataset):
        print(f"{self.name} is training on {dataset}...")

    def predict(self, data):
        print(f"{self.name} predicting classes for {data}")
        return ["Positive", "Negative", "Positive"]


class RegressionModel(MLModel):
    """
    Regression model implementation.
    """

    def train(self, dataset):
        print(f"{self.name} is training on {dataset}...")

    def predict(self, data):
        print(f"{self.name} predicting numerical values for {data}")
        return [125.5, 210.8, 175.2]


# Create objects
classification_model = ClassificationModel("Random Forest Classifier")
regression_model = RegressionModel("Linear Regression")


# Display model information
print(classification_model.model_info())
print(regression_model.model_info())


# Polymorphism
models = [
    classification_model,
    regression_model
]

for model in models:
    model.train("Training Dataset")
    predictions = model.predict("Test Data")
    print("Predictions:", predictions)
    print("-" * 50)
